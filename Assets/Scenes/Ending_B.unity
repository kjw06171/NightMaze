--- !u!114 &560011863
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 560011862}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ee5afbbb48541fe42adaf85d2080ea03, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  canvasGroup: {fileID: 435979869}
  textUI: {fileID: 885981056}
  lines:
  - "\uB098\uB294 \uC628\uBAB8\uC5D0 \uC2DD\uC740\uB540\uC744 \uD758\uB9AC\uBA70
    \uCE68\uB300\uC5D0\uC11C \uBC8C\uB5A1 \uC77C\uC5B4\uB0AC\uB2E4."
  - "\u201C\uD558\uC544... \uD558\uC544...\uAFC8\uC778\uAC00...\u201D\r"
  - "\uB054\uCC0D\uD55C \uAFC8\uC740 \uC5EC\uC804\uD788 \uACFC\uAC70\uB97C \uC0C1\uAE30\uC2DC\uD0A4\uB824
    \uD558\uC9C0\uB9CC, \uD2B8\uB77C\uC6B0\uB9C8\uAC00 \uC0C8\uACA8 \uB123\uC5C8\uB358
    \n'\uC5B4\uB9B0\uC544\uC774\uC758 \uAE30\uC5B5'\uC740 \uB354 \uC774\uC0C1 \uB098\uB97C
    \uBD99\uC7A1\uC544 \uB450\uC9C0 \uBABB\uD588\uB2E4."
  - "\"\uADF8\uB798, \uC774\uC81C \uB193\uC544\uC904 \uB54C\uAC00 \uB418\uC5C8\uC9C0.\""
  - "\"\uC624\uB298 \uB0B4\uAC00 \uD574\uC57C \uD560 \uC77C\uC774 \uBB50\uB354\uB77C?\""
  - "\uB208\uC744 \uAC10\uC73C\uB2C8, \uC5B4\uB838\uC744 \uB54C \uC6B8\uACE0 \uC788\uB294
    \uC790\uC2E0\uC758 \uBAA8\uC2B5\uC774 \uCC30\uB098\uCC98\uB7FC \uC77C\uB801\uC774\uB4EF
    \uBCF4\uC600\uB2E4."
  - "\uADF8\uB7EC\uB098 \uB098\uB294 \uADF8 \uBAA8\uC2B5\uC744 \uC678\uBA74\uD558\uC9C0
    \uC54A\uACE0, \uC870\uC6A9\uD788 \uB208\uC744 \uB72C\uB2E4."
  - "\uC584\uD30D\uD558\uACE0 \uB367\uC5C6\uB294 \uD76C\uB9DD\uC740, \uC774\uC81C
    \uB354 \uC774\uC0C1 \uBD99\uC7A1\uACE0 \uC788\uC744 \uD544\uC694\uAC00 \uC5C6\uC5C8\uB2E4."
  - "\uACFC\uAC70\uC5D0 \uC0AC\uB85C\uC7A1\uD600\uC11C\uB294 \uBBF8\uB798\uB85C \uB098\uC544\uAC08
    \uC218 \uC5C6\uB2E4. \n\uB354 \uC774\uC0C1 \uC774 \uAE30\uC5B5\uC740 \uB098\uB97C
    \uC62D\uC544\uB9E4\uC9C0 \uBABB\uD560 \uAC83\uC774\uB2E4. "
  - "Happy Ending - \uB098\uC544\uAC00\uB294 \uBBF8\uB798"
  typingSpeed: 0.05
  lineDelay: 1.7
  fadeTime: 2
  finalHoldTime: 3
  typingAudioSource: {fileID: 55635317}
  typingSoundClip: {fileID: 8300000, guid: d5f4a98f917346b418c852045baffe8b, type: 3}
  typingSoundInterval: 0.06
  typingVolume: 0.402
  returnSceneName: LoadingScene 4
