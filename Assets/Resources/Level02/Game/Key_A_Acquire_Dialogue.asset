  dialogueSentences:
  - speakerName: 
    portrait: {fileID: 0}
    sentence: "\uC18D\uC774 \uB9E4\uC2A4\uAECD\uACE0 \uBA38\uB9AC\uAC00 \uD130\uC9C8
      \uB4EF \uC544\uD30C\uC628\uB2E4. \uC628\uBAB8\uC758 \uC2E0\uACBD\uC774 \uADF9\uB3C4\uB85C
