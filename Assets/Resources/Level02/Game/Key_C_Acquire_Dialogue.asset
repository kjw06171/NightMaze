    portrait: {fileID: -794526486, guid: 1a90747706f61ac4ab54ada0de1d2602, type: 3}
    sentence: "\uC7A0\uAE50... \uADF8\uB7EC\uBA74 \uB098\uB97C \uCAD3\uC544\uC624\uB358
      \uADF8 \uADF8\uB9BC\uC790 \uAD34\uBB3C\uC740..."
  - speakerName: 
    portrait: {fileID: 0}
    sentence: "\uBAA8\uB4E0 \uC870\uAC01\uC774 \uB9DE\uCDB0\uC9C4\uB2E4. \uACF5\uD3EC,
      \uC18C\uB9AC, \uACE0\uB9BD... \uC774 \uC800\uD0DD\uC758 \uBAA8\uB4E0 \uD3ED\uB825\uC740
