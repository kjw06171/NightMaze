  dialogueSentences:
  - speakerName: 
    portrait: {fileID: 0}
    sentence: "\uC950\uB4E4\uC758 \uC545\uCDE8\uC640 \uCC0D\uCC0D\uB300\uB294 \uC18C\uB9AC\uAC00
      \uADD3\uAC00\uC5D0 \uC120\uBA85\uD55C \uD658\uCCAD\uCC98\uB7FC \uB4E4\uB9B0\uB2E4.
      \uC2DC\uC57C\uAC00 \uD750\uB824\uC9C0\uACE0 \uB208\uBB3C\uC774 \uACE0\uC778\uB2E4."
  - speakerName: "\uC720\uB098"
    portrait: {fileID: -794526486, guid: 1a90747706f61ac4ab54ada0de1d2602, type: 3}
    sentence: "\uB098... \uC5EC\uAE30 \uD63C\uC790 \uB0A8\uACA8\uC84C\uB358 \uAC70\uC57C?
      \uC5B4\uB460 \uC18D\uC5D0... \uC78A\uD78C \uCC44\uB85C..."
  - speakerName: "\uC720\uB098"
    portrait: {fileID: -794526486, guid: 1a90747706f61ac4ab54ada0de1d2602, type: 3}
    sentence: "\uC774\uC81C \uC54C\uACA0\uC5B4. \uC5B4\uB460\uC774 \uBB34\uC11C\uC6B4
      \uAC8C \uC544\uB2C8\uC5C8\uC5B4. \uB098\uB97C \uD63C\uC790 \uB0B4\uBC84\uB824
      \uB454... \uADF8 \uC0AC\uB78C\uC774 \uBB34\uC11C\uC6E0\uB358 \uAC70\uC57C."
  characterName: "\uC720\uB098"
  portrait: {fileID: -5995739062224757819, guid: 1a90747706f61ac4ab54ada0de1d2602, type: 3}
