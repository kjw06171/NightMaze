  dialogueSentences:
  - speakerName: 
    portrait: {fileID: 0}
    sentence: "\uC881\uACE0 \uC5B4\uB450\uC6B4 \uCC3D\uACE0\uC5D0\uC11C \uD76C\uBBF8\uD55C
      \uACF0\uD321\uC774 \uB0C4\uC0C8\uC640 \uD568\uAED8 \uC12C\uB729\uD55C \uAE34\uC7A5\uAC10\uC774
      \uB290\uAEF4\uC9C4\uB2E4. \uBAB8\uC774 \uBCBD\uC5D0 \uBC14\uC9DD \uB2EC\uB77C\uBD99\uB294\uB2E4."
  - speakerName: "\uC720\uB098"
    portrait: {fileID: -794526486, guid: 1a90747706f61ac4ab54ada0de1d2602, type: 3}
    sentence: "\uC5EC\uAE30\uC11C\u2026 \uB300\uCCB4 \uBB58 \uADF8\uB807\uAC8C \uB450\uB824\uC6CC\uD588\uB358
      \uAC78\uAE4C? \uC2EC\uC7A5\uC774 \uC774\uC720 \uC5C6\uC774 \uB5A8\uB824. \uC774\uAC74
      \uB2E8\uC21C\uD55C \uACF5\uD3EC\uAC00 \uC544\uB2C8\uC57C."
  - speakerName: "\uC720\uB098"
    portrait: {fileID: -794526486, guid: 1a90747706f61ac4ab54ada0de1d2602, type: 3}
    sentence: "\uBAB8\uC774 \uBA3C\uC800 \uAE30\uC5B5\uD558\uACE0 \uC788\uC5B4. \uC774
      \uC881\uC740 \uACF3\uC5D0... \uAC07\uD600 \uC788\uC5C8\uB358 \uAC74\uAC00?"
  characterName: "\uC720\uB098"
